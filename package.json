{
  "name": "agent-job",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node --env-file=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "e2e run --exclude-tag live",
    "test:e2e:smoke": "e2e run --tag smoke",
    "test:e2e:live": "e2e run --tag live"
  },
  "dependencies": {
    "@lucide/vue": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-anthropic": "1.0.0",
    "@tanstack/ai-gemini": "^1.0.0",
    "@tanstack/ai-mcp": "^1.0.0",
    "@tanstack/ai-openai": "^1.0.0",
    "@tanstack/ai-vue": "^1.0.0",
    "@tanstack/vue-table": "^9.3.1",
    "better-sqlite3": "^13.0.3",
    "daisyui": "^5.7.50",
    "drizzle-orm": "1.0.0-rc.4",
    "nuxt": "^4.6.3",
    "tailwindcss": "^4.3.3",
    "unpdf": "^1.9.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.36",
    "@e2e-dev/web": "^0.15.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "1.0.0-rc.4",
    "e2e": "^0.23.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.90.0"
  }
}
